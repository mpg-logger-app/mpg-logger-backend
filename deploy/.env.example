# Copy to .env in this folder, fill in the password, and copy it to the VM (HOSTING.md, step 5.1).
# .env holds the database password, so it's never committed (see .gitignore).

# The app's address, without https://. Caddy gets its HTTPS certificate.
SITE_ADDRESS=mpg-logger.duckdns.org

# The Neon database, the same values as for running the app locally (see README).
DB_URL=jdbc:postgresql://ep-falling-hat-b52u8qyv-pooler.c-7.us-east-2.aws.neon.tech/mpgloggerdb?sslmode=require
DB_USERNAME=mpgloggerdb_owner
DB_PASSWORD=
